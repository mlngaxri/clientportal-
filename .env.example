# Local runtime: development | staging | production. NODE_ENV is managed by Next.js.
APP_ENV=development
APP_URL=http://localhost:3000
# Supabase: use a separate project for staging. Never reuse production secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase project references are nonsecret IDs, used to enforce isolation.
SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
# Google client ID/secret belong in Supabase provider settings, not browser code.
# Authorized callback in Google: https://<supabase-project-ref>.supabase.co/auth/v1/callback
# Supabase redirect allowlist: exact APP_URL/auth/callback
# Stripe: sk_test_* is mandatory in staging; webhook secrets are endpoint-specific.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_PRO_BILLING=false
# Staging deployment credentials/configuration. Vercel connector login is not a CLI token.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Release feature gates must remain false until acceptance evidence exists.
ENABLE_LIVE_CUSTOMERS=false
ENABLE_FIRST_BILLING=false
# Planned adapters below are configuration contracts, not completed functionality.
# Resend: verified sending domain; delivery webhooks required before forms pass launch checks.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
STAGING_TEST_RECIPIENT=
# Existing private bucket is created by the migration.
STORAGE_BUCKET=project-assets
# Planned signed uploads and scanning. Current server upload still caps at 4 MB.
UPLOAD_MAX_BYTES=104857600
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
# Dedicated staging-only domain for genuine TLS/domain/analytics/form verification.
STAGING_SITE_DOMAIN=
# Planned analytics/cron/site-adapter credentials; never expose in NEXT_PUBLIC variables.
ANALYTICS_SIGNING_SECRET=
SITE_ADAPTER_SIGNING_SECRET=
CRON_SECRET=
# Planned server-side intelligence adapter. Provider is intentionally configurable.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Planned monitoring sink. No raw customer content should be logged.
ERROR_REPORTING_DSN=

# Protected health endpoint
HEALTHCHECK_TOKEN=
