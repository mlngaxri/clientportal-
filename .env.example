# Next.js sets NODE_ENV. APP_ENV controls local-only loopback exceptions.
APP_ENV=development
APP_URL=http://localhost:4173
NEXT_PUBLIC_MARKETING_URL=https://fourthform-marketing.vercel.app
# Supabase Auth, Postgres and private Storage. Server role is never public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
# Enable Google inside Supabase. Its callback is the Supabase auth/v1/callback URL.
# Supabase redirect allowlist includes APP_URL/auth/callback and recovery redirect.
# Checkout uses owner reservations and authoritative signed provider receipts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_LIVE_CUSTOMERS=false
ENABLE_PRO_BILLING=false
ENABLE_FIRST_BILLING=false
# Optional verified custom domains. Scope the token to the intended Vercel team.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Optional transactional notifications. Without these, inboxes still persist.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
# Independent random secrets of at least 32 characters for production.
ANALYTICS_SIGNING_SECRET=
SITE_ADAPTER_SIGNING_SECRET=
SESSION_SIGNING_SECRET=
RATE_LIMIT_SECRET=
CRON_SECRET=
HEALTHCHECK_TOKEN=
# Images, audio, video and text go to the migration-created private project-assets bucket.
UPLOAD_MAX_BYTES=104857600
# Office/PDF document uploads remain disabled until a scanner is configured.
# Scanner POST receives bytes and must return JSON {"clean":true}; documents cap at 16 MB.
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
# Optional external CMS adapter. Built-in CMS and website renderer are the default.
SITE_ADAPTER_URL=
SITE_ADAPTER_TOKEN=
# Separate staging services and a controlled recipient/domain for provider acceptance.
STAGING_SITE_DOMAIN=
STAGING_TEST_RECIPIENT=
